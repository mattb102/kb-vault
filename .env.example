# Copy to .env and fill in your values. This file is NOT committed.
# The bootstrap scripts fill in most of these for you.

# ─── Core (required for http transport) ─────────────────────────────────────
API_KEY=your-long-random-api-key
AUTH_PASSWORD=your-passphrase-for-the-sign-in-page
VAULT_PATH=/absolute/path/to/your/vault

# ─── Embeddings (leave blank to use the local model) ────────────────────────
# OPENAI_API_KEY=sk-...      # only if embeddingProvider: openai in config.yaml

# ─── Pattern synthesis + morning report ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...  # powers promote_patterns and morning_report generation

# ─── ios_app / push notifications ───────────────────────────────────────────
APP_TOKEN=your-phone-app-token        # separate from API_KEY on purpose
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com  # included in push requests; any URI works

# ─── Discord (optional, for morning report) ─────────────────────────────────
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ─── OpenAI TTS (optional, for spoken morning report) ───────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_TTS_MODEL=gpt-4o-mini-tts    # default
# OPENAI_TTS_VOICE=onyx               # default

# ─── Kokoro TTS (opt-in local TTS, no API cost) ─────────────────────────────
# TTS_PROVIDER=kokoro                 # set to "kokoro" to use; default is "openai"
# KOKORO_MODEL_PATH=/path/to/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/path/to/voices-v1.0.bin  # defaults to same dir as model
# KOKORO_PYTHON=python3               # python executable with kokoro-onnx installed
# KOKORO_VOICE=af_heart               # default voice
# KOKORO_SYNTH_SCRIPT=scripts/kokoro_synth.py  # override script path if needed

# ─── Claude Code delegation (claude_code plugin) ────────────────────────────
# CLAUDE_CODE_DEFAULT_DIR=/path/to/your/project
# CLAUDE_CODE_MODEL=opus              # default
# CLAUDE_CODE_EFFORT=high             # default
# CLAUDE_BIN=claude                   # path to claude CLI binary

# ─── Google Calendar (calendar plugin) ──────────────────────────────────────
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://your-domain.com/calendar/callback

# ─── MAL (mal plugin + sync-mal.ts) ─────────────────────────────────────────
# MAL_USERNAME=your-myanimelist-username   # public username, used by sync-mal.ts

# ─── Steam (sync-steam.ts) ──────────────────────────────────────────────────
# STEAM_API_KEY=...        # get one at store.steampowered.com/dev/apikey
# STEAM_USER_ID=...        # your 64-bit Steam ID (SteamID64)

# ─── HTTP transport settings ─────────────────────────────────────────────────
# BASE_URL=https://your-domain.com    # shown in the sign-in page and OAuth discovery
# HOST=0.0.0.0
# PORT=3000
